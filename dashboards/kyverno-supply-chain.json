{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "kyverno-supply-chain"
  },
  "spec": {
    "title": "Supply Chain Policies",
    "description": "Kyverno policy checks at admission: active policies, accepted requests and violations.",
    "tags": [
      "kyverno",
      "supply-chain"
    ],
    "editable": true,
    "cursorSync": "Off",
    "liveNow": false,
    "preload": false,
    "links": [],
    "annotations": [],
    "elements": {
      "policies": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Active policies",
          "description": "Kyverno policies (policies.kyverno.io) that have evaluated at least one resource since Kyverno started.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "A",
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "count(count by (policy_namespace, policy_name) ({__name__=~\"kyverno_.+_policy_results_total\"}))",
                        "legendFormat": "",
                        "instant": true,
                        "range": false
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.3.0",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "#5794F2",
                        "value": 0
                      }
                    ]
                  },
                  "unit": "short",
                  "decimals": 0,
                  "noValue": "0"
                },
                "overrides": []
              },
              "options": {
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "orientation": "auto",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "text": {
                  "valueSize": 96
                },
                "textMode": "value",
                "wideLayout": true
              }
            }
          }
        }
      },
      "accepted": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Accepted",
          "description": "Admission requests that passed a policy check in the selected time range.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "A",
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "clamp_min(\n  sum ({__name__=~\"kyverno_.+_policy_results_total\", execution_cause=\"admission_request\", result=\"pass\"})\n  - (sum ({__name__=~\"kyverno_.+_policy_results_total\", execution_cause=\"admission_request\", result=\"pass\"} offset $__range) or sum ({__name__=~\"kyverno_.+_policy_results_total\", execution_cause=\"admission_request\", result=\"pass\"}) * 0),\n0)",
                        "legendFormat": "",
                        "instant": true,
                        "range": false
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.3.0",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "#73BF69",
                        "value": 0
                      }
                    ]
                  },
                  "unit": "short",
                  "decimals": 0,
                  "noValue": "0"
                },
                "overrides": []
              },
              "options": {
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "orientation": "auto",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "text": {
                  "valueSize": 96
                },
                "textMode": "value",
                "wideLayout": true
              }
            }
          }
        }
      },
      "violations": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Violations",
          "description": "Admission requests that failed a policy check in the selected time range. Deny policies block these requests.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "A",
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "clamp_min(\n  sum ({__name__=~\"kyverno_.+_policy_results_total\", execution_cause=\"admission_request\", result=\"fail\"})\n  - (sum ({__name__=~\"kyverno_.+_policy_results_total\", execution_cause=\"admission_request\", result=\"fail\"} offset $__range) or sum ({__name__=~\"kyverno_.+_policy_results_total\", execution_cause=\"admission_request\", result=\"fail\"}) * 0),\n0)",
                        "legendFormat": "",
                        "instant": true,
                        "range": false
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.3.0",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "#73BF69",
                        "value": 0
                      },
                      {
                        "color": "#F2495C",
                        "value": 1
                      }
                    ]
                  },
                  "unit": "short",
                  "decimals": 0,
                  "noValue": "0"
                },
                "overrides": []
              },
              "options": {
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "orientation": "auto",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "text": {
                  "valueSize": 96
                },
                "textMode": "value",
                "wideLayout": true
              }
            }
          }
        }
      },
      "rate": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Acceptance rate",
          "description": "Share of policy checks at admission that passed in the selected time range.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "A",
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "100 * (clamp_min(\n  sum ({__name__=~\"kyverno_.+_policy_results_total\", execution_cause=\"admission_request\", result=\"pass\"})\n  - (sum ({__name__=~\"kyverno_.+_policy_results_total\", execution_cause=\"admission_request\", result=\"pass\"} offset $__range) or sum ({__name__=~\"kyverno_.+_policy_results_total\", execution_cause=\"admission_request\", result=\"pass\"}) * 0),\n0) or vector(0))\n/\n(((clamp_min(\n  sum ({__name__=~\"kyverno_.+_policy_results_total\", execution_cause=\"admission_request\", result=\"pass\"})\n  - (sum ({__name__=~\"kyverno_.+_policy_results_total\", execution_cause=\"admission_request\", result=\"pass\"} offset $__range) or sum ({__name__=~\"kyverno_.+_policy_results_total\", execution_cause=\"admission_request\", result=\"pass\"}) * 0),\n0)) or vector(0)) + ((clamp_min(\n  sum ({__name__=~\"kyverno_.+_policy_results_total\", execution_cause=\"admission_request\", result=\"fail\"})\n  - (sum ({__name__=~\"kyverno_.+_policy_results_total\", execution_cause=\"admission_request\", result=\"fail\"} offset $__range) or sum ({__name__=~\"kyverno_.+_policy_results_total\", execution_cause=\"admission_request\", result=\"fail\"}) * 0),\n0)) or vector(0)) > 0)",
                        "legendFormat": "",
                        "instant": true,
                        "range": false
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.3.0",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "#F2495C",
                        "value": 0
                      },
                      {
                        "color": "#FF9830",
                        "value": 90
                      },
                      {
                        "color": "#73BF69",
                        "value": 99.95
                      }
                    ]
                  },
                  "unit": "percent",
                  "decimals": 1,
                  "noValue": "\u2013"
                },
                "overrides": []
              },
              "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "center",
                "orientation": "auto",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "text": {
                  "valueSize": 96
                },
                "textMode": "value",
                "wideLayout": true
              }
            }
          }
        }
      },
      "decisions": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Policy decisions",
          "description": "Policy checks at admission, per interval.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "A",
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "clamp_min(\n  sum ({__name__=~\"kyverno_.+_policy_results_total\", execution_cause=\"admission_request\", result=\"pass\"})\n  - (sum ({__name__=~\"kyverno_.+_policy_results_total\", execution_cause=\"admission_request\", result=\"pass\"} offset $__interval) or sum ({__name__=~\"kyverno_.+_policy_results_total\", execution_cause=\"admission_request\", result=\"pass\"}) * 0),\n0)",
                        "legendFormat": "Accepted",
                        "instant": false,
                        "range": true
                      }
                    }
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "B",
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "clamp_min(\n  sum ({__name__=~\"kyverno_.+_policy_results_total\", execution_cause=\"admission_request\", result=\"fail\"})\n  - (sum ({__name__=~\"kyverno_.+_policy_results_total\", execution_cause=\"admission_request\", result=\"fail\"} offset $__interval) or sum ({__name__=~\"kyverno_.+_policy_results_total\", execution_cause=\"admission_request\", result=\"fail\"}) * 0),\n0)",
                        "legendFormat": "Violations",
                        "instant": false,
                        "range": true
                      }
                    }
                  }
                }
              ],
              "queryOptions": {
                "interval": "30s"
              },
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.3.0",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "#73BF69"
                  },
                  "min": 0,
                  "unit": "short",
                  "decimals": 0,
                  "custom": {
                    "drawStyle": "bars",
                    "fillOpacity": 85,
                    "lineWidth": 1,
                    "barAlignment": 0,
                    "barWidthFactor": 0.8,
                    "gradientMode": "none",
                    "showPoints": "never",
                    "axisPlacement": "auto",
                    "axisLabel": "",
                    "axisSoftMax": 3,
                    "stacking": {
                      "group": "A",
                      "mode": "normal"
                    },
                    "hideFrom": {
                      "legend": false,
                      "tooltip": false,
                      "viz": false
                    }
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Violations"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "mode": "fixed",
                          "fixedColor": "#F2495C"
                        }
                      }
                    ]
                  }
                ]
              },
              "options": {
                "legend": {
                  "calcs": [
                    "sum"
                  ],
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "none",
                  "hideZeros": false
                }
              }
            }
          }
        }
      },
      "table": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Policies",
          "description": "Policy checks at admission per policy, in the selected time range.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "A",
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "label_replace(\n(clamp_min(\n  sum by (policy_namespace, policy_name, policy_validation_mode) ({__name__=~\"kyverno_.+_policy_results_total\", execution_cause=\"admission_request\", result=\"pass\"})\n  - (sum by (policy_namespace, policy_name, policy_validation_mode) ({__name__=~\"kyverno_.+_policy_results_total\", execution_cause=\"admission_request\", result=\"pass\"} offset $__range) or sum by (policy_namespace, policy_name, policy_validation_mode) ({__name__=~\"kyverno_.+_policy_results_total\", execution_cause=\"admission_request\", result=\"pass\"}) * 0),\n0))\nor sum by (policy_namespace, policy_name, policy_validation_mode) ({__name__=~\"kyverno_.+_policy_results_total\", execution_cause=\"admission_request\"}) * 0,\n\"policy_namespace\", \"cluster-wide\", \"policy_namespace\", \"\")",
                        "legendFormat": "",
                        "instant": true,
                        "range": false,
                        "format": "table"
                      }
                    }
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "B",
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "label_replace(\n(clamp_min(\n  sum by (policy_namespace, policy_name, policy_validation_mode) ({__name__=~\"kyverno_.+_policy_results_total\", execution_cause=\"admission_request\", result=\"fail\"})\n  - (sum by (policy_namespace, policy_name, policy_validation_mode) ({__name__=~\"kyverno_.+_policy_results_total\", execution_cause=\"admission_request\", result=\"fail\"} offset $__range) or sum by (policy_namespace, policy_name, policy_validation_mode) ({__name__=~\"kyverno_.+_policy_results_total\", execution_cause=\"admission_request\", result=\"fail\"}) * 0),\n0))\nor sum by (policy_namespace, policy_name, policy_validation_mode) ({__name__=~\"kyverno_.+_policy_results_total\", execution_cause=\"admission_request\"}) * 0,\n\"policy_namespace\", \"cluster-wide\", \"policy_namespace\", \"\")",
                        "legendFormat": "",
                        "instant": true,
                        "range": false,
                        "format": "table"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": [
                {
                  "kind": "merge",
                  "spec": {
                    "id": "merge",
                    "options": {}
                  }
                },
                {
                  "kind": "organize",
                  "spec": {
                    "id": "organize",
                    "options": {
                      "excludeByName": {
                        "Time": true
                      },
                      "indexByName": {
                        "policy_namespace": 0,
                        "policy_name": 1,
                        "policy_validation_mode": 2,
                        "Value #A": 3,
                        "Value #B": 4
                      },
                      "renameByName": {
                        "policy_namespace": "Namespace",
                        "policy_name": "Policy",
                        "policy_validation_mode": "Mode",
                        "Value #A": "Accepted",
                        "Value #B": "Violations"
                      }
                    }
                  }
                }
              ]
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.3.0",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "text"
                  },
                  "decimals": 0,
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "inspect": false
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "text",
                        "value": 0
                      }
                    ]
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Accepted"
                    },
                    "properties": [
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-text"
                        }
                      },
                      {
                        "id": "color",
                        "value": {
                          "mode": "fixed",
                          "fixedColor": "#73BF69"
                        }
                      },
                      {
                        "id": "custom.width",
                        "value": 120
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Violations"
                    },
                    "properties": [
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-background",
                          "mode": "basic"
                        }
                      },
                      {
                        "id": "color",
                        "value": {
                          "mode": "thresholds"
                        }
                      },
                      {
                        "id": "thresholds",
                        "value": {
                          "mode": "absolute",
                          "steps": [
                            {
                              "color": "transparent",
                              "value": 0
                            },
                            {
                              "color": "#F2495C",
                              "value": 1
                            }
                          ]
                        }
                      },
                      {
                        "id": "custom.width",
                        "value": 120
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Mode"
                    },
                    "properties": [
                      {
                        "id": "mappings",
                        "value": [
                          {
                            "type": "value",
                            "options": {
                              "Deny": {
                                "text": "Enforce",
                                "color": "#5794F2",
                                "index": 0
                              },
                              "Audit": {
                                "text": "Audit",
                                "color": "#FF9830",
                                "index": 1
                              }
                            }
                          }
                        ]
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-text"
                        }
                      },
                      {
                        "id": "custom.width",
                        "value": 110
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Namespace"
                    },
                    "properties": [
                      {
                        "id": "custom.width",
                        "value": 150
                      }
                    ]
                  }
                ]
              },
              "options": {
                "cellHeight": "lg",
                "showHeader": true,
                "footer": {
                  "show": false,
                  "reducer": [
                    "sum"
                  ],
                  "countRows": false,
                  "fields": ""
                },
                "sortBy": [
                  {
                    "displayName": "Violations",
                    "desc": true
                  }
                ]
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "GridLayout",
      "spec": {
        "items": [
          {
            "kind": "GridLayoutItem",
            "spec": {
              "element": {
                "kind": "ElementReference",
                "name": "policies"
              },
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 7
            }
          },
          {
            "kind": "GridLayoutItem",
            "spec": {
              "element": {
                "kind": "ElementReference",
                "name": "accepted"
              },
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 7
            }
          },
          {
            "kind": "GridLayoutItem",
            "spec": {
              "element": {
                "kind": "ElementReference",
                "name": "violations"
              },
              "x": 12,
              "y": 0,
              "width": 6,
              "height": 7
            }
          },
          {
            "kind": "GridLayoutItem",
            "spec": {
              "element": {
                "kind": "ElementReference",
                "name": "rate"
              },
              "x": 18,
              "y": 0,
              "width": 6,
              "height": 7
            }
          },
          {
            "kind": "GridLayoutItem",
            "spec": {
              "element": {
                "kind": "ElementReference",
                "name": "decisions"
              },
              "x": 0,
              "y": 7,
              "width": 11,
              "height": 14
            }
          },
          {
            "kind": "GridLayoutItem",
            "spec": {
              "element": {
                "kind": "ElementReference",
                "name": "table"
              },
              "x": 11,
              "y": 7,
              "width": 13,
              "height": 14
            }
          }
        ]
      }
    },
    "timeSettings": {
      "from": "now-15m",
      "to": "now",
      "autoRefresh": "5s",
      "autoRefreshIntervals": [
        "5s",
        "10s",
        "30s",
        "1m"
      ],
      "timezone": "browser",
      "fiscalYearStartMonth": 0,
      "hideTimepicker": false
    },
    "variables": [
      {
        "kind": "DatasourceVariable",
        "spec": {
          "name": "datasource",
          "label": "Data source",
          "pluginId": "prometheus",
          "hide": "hideVariable",
          "current": {
            "text": "Prometheus",
            "value": "prometheus"
          },
          "refresh": "onDashboardLoad",
          "regex": "",
          "multi": false,
          "includeAll": false,
          "allowCustomValue": true,
          "options": [],
          "skipUrlSync": false
        }
      }
    ]
  }
}
